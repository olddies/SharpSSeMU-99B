@page "/chaos-mix"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@using MuServer.AdminPanel.Components.Shared
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>Chaos Machine</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Chaos Machine</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
    @L["Data/GameServerInfo - ChaosMix.dat -- the success rates (%) that ChaosMixLogic really uses to work out whether a Chaos Box combination, +10/11/12/13, wings, pet, etc. succeeds."] <b>-1</b> @L["means \"no fixed rate from config\": those combinations (Chaos Box and wings) compute the % with a formula based on the money invested instead of reading this value."]
</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    @L["The AL1/AL2/AL3 columns are per premium account level -- see the server documentation for how account levels are applied. All 4 are shown and editable so that no value in the file is lost."]
</MudAlert>

@if (_rates is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@L["General"]</MudText>
        <RateGroupTable Rows="@(ChaosMixLayout.Singles.Select(g => (g.Title, _rates[g.Prefix])))" />
    </MudPaper>

    @foreach (var group in ChaosMixLayout.Numbered)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@group.Title</MudText>
            <RateGroupTable Rows="@(Enumerable.Range(1, group.Count).Select(n => (L.F("Map {0}", n), _rates[group.Prefix + n])))" />
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Level upgrade (+10 to +13)"]</MudText>
        <RateGroupTable Rows="@(ChaosMixLayout.PlusLevels.SelectMany(g => new (string, RateSet)[]
        {
            (L.F("{0} -- normal item", L[g.Title]), _rates[g.CommonPrefix]),
            (L.F("{0} -- excellent/set", L[g.Title]), _rates[g.ExcSetPrefix]),
        }))" />
    </MudPaper>

    <div class="d-flex gap-2 mt-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@_saving">
            @L["Save to ChaosMix.dat"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        @L.F("A backup ({0}) is saved the first time you save in this session.", "GameServerInfo - ChaosMix.dat.bak")
    </MudText>
}

@code {
    private IniDocument? _doc;
    private Dictionary<string, RateSet>? _rates;
    private bool _saving;
    private bool _backedUp;

    private string Path => DataPaths.Combine("GameServerInfo - ChaosMix.dat");

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync()
    {
        var (doc, rates) = ChaosMixConfigRepository.Load(Path);
        _doc = doc;
        _rates = rates;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_doc is null || _rates is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (!_backedUp)
            {
                var backupPath = Path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(Path, backupPath);
                }
                _backedUp = true;
            }

            ChaosMixConfigRepository.Save(Path, _doc, _rates);
            Snackbar.Add(L["Saved to GameServerInfo - ChaosMix.dat."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
