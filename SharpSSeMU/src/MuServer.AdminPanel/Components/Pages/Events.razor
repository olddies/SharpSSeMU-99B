@page "/events"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Events"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Events"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Data/Event/*.dat -- schedules, durations and rewards of Devil Square, Blood Castle, Chaos Castle, Kalima, invasions and bonuses. Each file carries several numbered tables; the column names you see come from the file's own comments."]
</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
    @L["Note: of these events the server only has"] <b>Devil Square</b> @L["and"] <b>Blood Castle</b> @L["ported. The other files edit and save fine, but no game system uses them yet."]
</MudAlert>

@if (_files.Count == 0)
{
    <MudAlert Severity="Severity.Warning">@L["The Data/Event folder was not found."]</MudAlert>
}
else
{
    <MudSelect T="string" Value="_selectedFile" ValueChanged="OnFileChanged" Label="@L["File"]"
               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Style="max-width: 420px;">
        @foreach (var file in _files)
        {
            <MudSelectItem Value="file">@file.Replace(".dat", "")</MudSelectItem>
        }
    </MudSelect>

    @if (_sections is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        @foreach (var section in _sections)
        {
            <MudPaper Class="pa-3 mb-4" Elevation="0">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudText Typo="Typo.subtitle1">@SectionTitle(section)</MudText>
                    <MudChip T="string" Size="Size.Small" Class="ma-0">@L.F("{0} row(s)", section.Rows.Count)</MudChip>
                </div>

                @if (section.ColumnTitles.Length == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @L["The column names of this section could not be deduced; it is left exactly as in the file."]
                    </MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Bordered="false" Style="overflow-x:auto">
                        <thead>
                            <tr>
                                @foreach (var title in section.ColumnTitles)
                                {
                                    <th>@title</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in section.Rows)
                            {
                                <tr>
                                    @for (int i = 0; i < section.ColumnTitles.Length; i++)
                                    {
                                        var index = i;
                                        <td>
                                            <MudTextField T="string" Value="@row[index]"
                                                          ValueChanged="@(v => row[index] = v ?? string.Empty)"
                                                          Margin="Margin.Dense" Variant="Variant.Text"
                                                          Style="max-width:110px" />
                                        </td>
                                    }
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       OnClick="@(() => section.Rows.Remove(row))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                               Class="mt-2" OnClick="@(() => AddRow(section))">
                        @L["Add row"]
                    </MudButton>
                }
            </MudPaper>
        }

        <div class="d-flex gap-2 mt-2 mb-8">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Save" Disabled="@_saving">
                @L.F("Save {0}", _selectedFile)
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadFile(_selectedFile))" Disabled="@_saving">
                @L["Discard changes"]
            </MudButton>
        </div>
    }
}

@code {
    private List<string> _files = [];
    private string _selectedFile = string.Empty;
    private string? _header;
    private List<TableSection>? _sections;
    private readonly HashSet<string> _backedUp = new();
    private bool _saving;

    private string EventDirectory => DataPaths.Combine("Event");

    private string PathFor(string file) => System.IO.Path.Combine(EventDirectory, file);

    protected override void OnInitialized()
    {
        _files = SectionedTableRepository.ListFiles(EventDirectory).ToList();

        if (_files.Count > 0)
        {
            OnFileChanged(_files[0]);
        }
    }

    /// <summary>Gives the section a readable name using its first column, which in these
    /// files almost always says what the table is about.</summary>
    private string SectionTitle(TableSection section) =>
        section.ColumnTitles.Length > 0
            ? L.F("Section {0} -- {1}…", section.Number, string.Join(", ", section.ColumnTitles.Take(3)))
            : L.F("Section {0}", section.Number);

    private void OnFileChanged(string file)
    {
        _selectedFile = file;
        LoadFile(file);
    }

    private void LoadFile(string file)
    {
        var (header, sections) = SectionedTableRepository.Load(PathFor(file));
        _header = header;
        _sections = sections;
    }

    private static void AddRow(TableSection section)
    {
        var values = new string[section.ColumnTitles.Length];
        Array.Fill(values, "0");
        section.Rows.Add(new FlatRow { Values = values });
    }

    private void Save()
    {
        if (_sections is null || _header is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var path = PathFor(_selectedFile);

            if (_backedUp.Add(path))
            {
                var backupPath = path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(path, backupPath);
                }
            }

            SectionedTableRepository.Save(path, _header, _sections);
            Snackbar.Add(L.F("Saved: {0} row(s) in {1}.", _sections.Sum(s => s.Rows.Count), _selectedFile), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
