@page "/global-message"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Global message"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Global message"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Sends a notice to every player connected right now (it is not stored for those who connect later). The GameServer picks it up within 2 seconds."]
</MudText>

<MudPaper Class="pa-4" Elevation="0" Style="max-width: 640px;">
    <MudTextField T="string" @bind-Value="_message" Label="@L["Message"]" Variant="Variant.Outlined"
                   Lines="3" MaxLength="120" Counter="120" Class="mb-4" />

    <MudRadioGroup T="byte" @bind-Value="_type" Class="mb-4">
        <MudRadio T="byte" Value="@((byte)0)" Color="Color.Primary">@L["Golden on-screen notice"]</MudRadio>
        <MudRadio T="byte" Value="@((byte)1)" Color="Color.Primary">@L["Blue chat message"]</MudRadio>
    </MudRadioGroup>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
               OnClick="Send" Disabled="@(_sending || string.IsNullOrWhiteSpace(_message))">
        @L["Send"]
    </MudButton>
</MudPaper>

@code {
    private string _message = string.Empty;
    private byte _type;
    private bool _sending;

    private void Send()
    {
        _sending = true;
        try
        {
            GlobalMessageRepository.Send(DataPaths.Root, _message.Trim(), _type);
            Snackbar.Add(L["Message sent."], Severity.Success);
            _message = string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not send: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }
}
