@page "/item-values"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>Precios</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Item prices"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Data/Item/ItemValue.txt -- explicit prices that"] <b>@L["override"]</b> @L["the general price formula. Jewels, event tickets and siege potions are here: if an item is not in this list, its shop price comes from the formula, not from here."]
</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    @L["The buy price is this value; the sell price to the NPC is a third of it. \"Level\" and \"Grade\" set to"] <b>*</b> @L["mean \"any\" -- so a single row covers every +0..+15 of the item."]
</MudAlert>

@if (_rows is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-2" Elevation="0">
        <MudDataGrid Items="@_rows" T="ItemValueRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     Bordered="false" Dense="true" FixedHeader="true" Height="62vh"
                     SortMode="SortMode.Multiple" QuickFilter="@QuickFilter">
            <ToolBarContent>
                <MudTextField T="string" @bind-Value="_search" Placeholder="@L["Search by name"]"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Clearable="true" Margin="Margin.Dense" Class="mt-0" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Section" Title="@L["Section"]" />
                <PropertyColumn Property="x => x.Sub" Title="@L["Index"]" />
                <TemplateColumn Title="@L["Item"]" Editable="false" Sortable="false">
                    <CellTemplate>@ItemName(context.Item)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Level"]" Sortable="false">
                    <CellTemplate>@(context.Item.Level?.ToString() ?? "*")</CellTemplate>
                    <EditTemplate>
                        <MudTextField T="string" Value="@(context.Item.Level?.ToString() ?? "*")"
                                      ValueChanged="@(v => context.Item.Level = ParseOptional(v))"
                                      Margin="Margin.Dense" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Grade"]" Sortable="false">
                    <CellTemplate>@(context.Item.Grade?.ToString() ?? "*")</CellTemplate>
                    <EditTemplate>
                        <MudTextField T="string" Value="@(context.Item.Grade?.ToString() ?? "*")"
                                      ValueChanged="@(v => context.Item.Grade = ParseOptional(v))"
                                      Margin="Margin.Dense" />
                    </EditTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.MoneyValue" Title="@L["Price (zen)"]" Format="N0" />
                <PropertyColumn Property="x => x.Comment" Title="@L["Comment"]" />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save" Disabled="@_saving">
            @L["Save to ItemValue.txt"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Reload" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
        <MudText Typo="Typo.caption" Class="mud-text-secondary align-self-center">
            @L.F("{0} price(s) defined", _rows.Count)
        </MudText>
    </div>
}

@code {
    private string? _header;
    private List<ItemValueRow>? _rows;
    private Dictionary<int, string> _itemNames = new();
    private string? _search;
    private bool _saving;
    private bool _backedUp;

    private string Path => DataPaths.Combine("Item", "ItemValue.txt");

    private Func<ItemValueRow, bool> QuickFilter => row =>
        string.IsNullOrWhiteSpace(_search)
        || row.Comment.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || ItemName(row).Contains(_search, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        LoadItemNames();
        Reload();
    }

    private void LoadItemNames()
    {
        try
        {
            var (_, rowsBySection) = ItemFileRepository.Load(DataPaths.Combine("Item", "Item.txt"));
            _itemNames = rowsBySection.Values.SelectMany(r => r).ToDictionary(r => r.Index, r => r.Name);
        }
        catch (Exception)
        {
            _itemNames = new Dictionary<int, string>();
        }
    }

    private string ItemName(ItemValueRow row) =>
        _itemNames.TryGetValue(row.Index, out var name) ? name : L["(unknown)"];

    private static int? ParseOptional(string? value) =>
        string.IsNullOrWhiteSpace(value) || value.Trim() == "*" ? null
        : int.TryParse(value.Trim(), out var n) ? n : null;

    private void Reload()
    {
        var (header, rows) = ItemValueFileRepository.Load(Path);
        _header = header;
        _rows = rows;
    }

    private void Save()
    {
        if (_rows is null || _header is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (!_backedUp)
            {
                var backupPath = Path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(Path, backupPath);
                }
                _backedUp = true;
            }

            ItemValueFileRepository.Save(Path, _header, _rows);
            Snackbar.Add(L.F("Saved: {0} prices.", _rows.Count), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
