@page "/items"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>Items</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Items</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Data/Item/Item.txt -- the real balance the GameServer uses to compute damage/defense and to choose which items monsters can drop. The file has 16 sections, each with different columns; pick a category to view and edit its columns."]
</MudText>

@if (_rowsBySection is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudSelect T="int" Value="_selectedSection" ValueChanged="OnSectionChangedAsync" Label="@L["Category"]"
               Variant="Variant.Outlined" Dense="true" Class="mb-4" Style="max-width: 360px;">
        @foreach (var (section, label) in ItemFileRepository.Sections)
        {
            <MudSelectItem Value="section">@($"{section} -- {L[label]}")</MudSelectItem>
        }
    </MudSelect>

    <MudPaper Class="pa-2" Elevation="0">
        <MudDataGrid Items="@CurrentRows" T="ItemRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     Bordered="false" Dense="true" FixedHeader="true" Height="65vh"
                     Filterable="true" SortMode="SortMode.Multiple">
            <Columns>
                <PropertyColumn Property="x => x.Sub" Title="@L["Index"]" Editable="false" />
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                <PropertyColumn Property="x => x.DropItem" Title="@L["Drops"]" />

                <PropertyColumn Property="x => x.Level" Title="@L["Level"]" />
                <PropertyColumn Property="x => x.Value" Title="@L["Value"]" Hidden="@(!HasValue)" />
                <PropertyColumn Property="x => x.BuyMoney" Title="@L["Price"]" Hidden="@(!HasBuyMoney)" />

                <PropertyColumn Property="x => x.DamageMin" Title="@L["Min. damage"]" Hidden="@(!HasDamage)" />
                <PropertyColumn Property="x => x.DamageMax" Title="@L["Max. damage"]" Hidden="@(!HasDamage)" />
                <PropertyColumn Property="x => x.AttackSpeed" Title="@L["Attack speed"]" Hidden="@(!HasAttackSpeed)" />
                <PropertyColumn Property="x => x.MagicDamageRate" Title="@L["% magic damage"]" Hidden="@(!HasMagicDamageRate)" />

                <PropertyColumn Property="x => x.Defense" Title="@L["Defense"]" Hidden="@(!HasDefense)" />
                <PropertyColumn Property="x => x.DefenseSuccessRate" Title="@L["% block"]" Hidden="@(!HasDefenseSuccessRate)" />
                <PropertyColumn Property="x => x.MagicDefense" Title="@L["Magic def."]" Hidden="@(!HasMagicDefense)" />
                <PropertyColumn Property="x => x.WalkSpeed" Title="@L["Move speed"]" Hidden="@(!HasWalkSpeed)" />
                <PropertyColumn Property="x => x.Durability" Title="@L["Durability"]" Hidden="@(!HasDurability)" />
                <PropertyColumn Property="x => x.SetAttr" Title="@L["Set"]" Hidden="@(!HasSetAttr)" />

                <PropertyColumn Property="x => x.RequireLevel" Title="@L["Req. level"]" Hidden="@(!HasRequireLevel)" />
                <PropertyColumn Property="x => x.RequireStrength" Title="@L["Req. strength"]" Hidden="@(!HasRequireStr)" />
                <PropertyColumn Property="x => x.RequireDexterity" Title="@L["Req. agility"]" Hidden="@(!HasRequireDex)" />
                <PropertyColumn Property="x => x.RequireEnergy" Title="@L["Req. energy"]" Hidden="@(!HasRequireEne)" />
                <PropertyColumn Property="x => x.RequireVitality" Title="@L["Req. vitality"]" Hidden="@(!HasRequireVit)" />
                <PropertyColumn Property="x => x.RequireLeadership" Title="@L["Req. command"]" Hidden="@(!HasRequireLead)" />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@_saving">
            @L["Save to Item.txt"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        @L["Saving rewrites all 16 sections of the file (not only the category you are viewing), but those you did not touch stay exactly as loaded. A backup (Item.txt.bak) is saved the first time you save in this session."]
    </MudText>
}

@code {
    private Dictionary<int, string>? _headers;
    private Dictionary<int, List<ItemRow>>? _rowsBySection;
    private int _selectedSection;
    private bool _saving;
    private bool _backedUp;

    private List<ItemRow> CurrentRows =>
        _rowsBySection is not null && _rowsBySection.TryGetValue(_selectedSection, out var rows)
            ? rows
            : new List<ItemRow>();

    private bool IsWeapon => _selectedSection is >= 0 and <= 5;
    private bool IsShield => _selectedSection == 6;
    private bool IsArmorPiece => _selectedSection is 7 or 8 or 9;
    private bool IsGloves => _selectedSection == 10;
    private bool IsBoots => _selectedSection == 11;
    private bool IsWings => _selectedSection == 12;
    private bool IsMisc => _selectedSection == 13;
    private bool IsConsumable => _selectedSection == 14;
    private bool IsScroll => _selectedSection == 15;
    private bool IsEquippable => IsWeapon || IsShield || IsArmorPiece || IsGloves || IsBoots || IsWings;

    private bool HasValue => IsConsumable;
    private bool HasBuyMoney => IsWings || IsScroll;
    private bool HasDamage => IsWeapon;
    private bool HasAttackSpeed => IsWeapon || IsGloves;
    private bool HasMagicDamageRate => IsWeapon;
    private bool HasDefense => IsShield || IsArmorPiece || IsGloves || IsBoots || IsWings;
    private bool HasDefenseSuccessRate => IsShield;
    private bool HasMagicDefense => IsArmorPiece;
    private bool HasWalkSpeed => IsBoots;
    private bool HasDurability => IsEquippable || IsMisc;
    private bool HasSetAttr => (IsEquippable && !IsWings) || IsMisc;
    private bool HasRequireLevel => !IsConsumable;
    private bool HasRequireStr => IsEquippable;
    private bool HasRequireDex => IsEquippable;
    private bool HasRequireEne => IsEquippable || IsScroll;
    private bool HasRequireVit => IsEquippable && !IsWings;
    private bool HasRequireLead => IsEquippable;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync()
    {
        var path = DataPaths.Combine("Item", "Item.txt");
        var (headers, rowsBySection) = ItemFileRepository.Load(path);
        _headers = headers;
        _rowsBySection = rowsBySection;
        return Task.CompletedTask;
    }

    private Task OnSectionChangedAsync(int section)
    {
        _selectedSection = section;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_rowsBySection is null || _headers is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var path = DataPaths.Combine("Item", "Item.txt");

            if (!_backedUp)
            {
                var backupPath = path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(path, backupPath);
                }
                _backedUp = true;
            }

            ItemFileRepository.Save(path, _headers, _rowsBySection);
            var total = _rowsBySection.Values.Sum(r => r.Count);
            Snackbar.Add(L.F("Saved: {0} items in 16 sections.", total), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
