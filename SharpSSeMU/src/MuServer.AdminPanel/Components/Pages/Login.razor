@page "/login"
@layout BareLayout
@using MuServer.AdminPanel.Auth
@inject AdminPassword AdminPassword
@attribute [AllowAnonymous]

@* No @rendermode on purpose: this page is served as static HTML and the form does a normal POST
   to /login. A Blazor circuit cannot write the session cookie (the headers were already sent when it
   starts), so the login has to be a plain old POST. *@

<PageTitle>@L["Sign in"]</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <h1>SSeMU <span>0.99B</span></h1>
        <p class="sub">@L["Administration panel"]</p>

        @if (Failed)
        {
            <div class="alert">@L["Wrong password."]</div>
        }

        @if (AdminPassword.IsGenerated)
        {
            <div class="note">
                @L["No password is configured: one was generated at start-up and printed in the panel console. To set a permanent one, add"] <code>Admin:Password</code> @L["to appsettings.json."]
            </div>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label for="password">@L["Password"]</label>
            <input id="password" name="password" type="password" autofocus autocomplete="current-password" />
            <button type="submit">@L["Sign in"]</button>
        </form>
    </div>
</div>

<style>
    .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0b0e14;
        font-family: Inter, system-ui, sans-serif;
    }

    .login-card {
        width: 340px;
        padding: 32px;
        border-radius: 14px;
        background: #141822;
        border: 1px solid #232838;
        color: #e6e8ee;
    }

    .login-card h1 { margin: 0; font-size: 1.4rem; }
    .login-card h1 span { color: #8b5cf6; }
    .login-card .sub { margin: 4px 0 24px; color: #8b93a7; font-size: .85rem; }

    .login-card label { display: block; font-size: .8rem; color: #8b93a7; margin-bottom: 6px; }

    .login-card input[type=password] {
        width: 100%;
        box-sizing: border-box;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #2c3245;
        background: #0f131c;
        color: #e6e8ee;
        font-size: .95rem;
    }

    .login-card input[type=password]:focus { outline: none; border-color: #8b5cf6; }

    .login-card button {
        width: 100%;
        margin-top: 16px;
        padding: 10px;
        border: 0;
        border-radius: 8px;
        background: #8b5cf6;
        color: #fff;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
    }

    .login-card button:hover { background: #7c4ef0; }

    .alert {
        margin-bottom: 16px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #3b1620;
        border: 1px solid #6b2233;
        color: #ffb4c0;
        font-size: .85rem;
    }

    .note {
        margin-bottom: 16px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #1a2030;
        border: 1px solid #2c3245;
        color: #9aa3b8;
        font-size: .78rem;
        line-height: 1.5;
    }

    .note code { color: #22d3ee; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public bool Failed { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
