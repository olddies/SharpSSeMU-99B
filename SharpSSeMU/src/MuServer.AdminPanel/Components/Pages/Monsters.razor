@page "/monsters"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Monsters"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Monsters"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Data/Monster/MonsterList.txt -- the statistics of each monster type. This defines"] <b>@L["what"]</b> @L["each monster is, not where it appears: spawns live in Data/Monster/Spawn/*.txt and are not edited here."]
</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    @L["The life/defense/damage values you see here are the file's; the GameServer applies on top of them the global multipliers of"] <b>@L["Configuration"] → Monster Settings</b> @L["(MonsterMaxLifeRate, MonsterPhysiDamageRate, etc.) when instantiating each monster."]
</MudAlert>

@if (_rows is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-2" Elevation="0">
        <MudDataGrid Items="@_rows" T="MonsterRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     Bordered="false" Dense="true" FixedHeader="true" Height="65vh"
                     Filterable="true" SortMode="SortMode.Multiple" QuickFilter="@QuickFilter">
            <ToolBarContent>
                <MudTextField T="string" @bind-Value="_search" Placeholder="@L["Search by name or index"]"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Clearable="true" Margin="Margin.Dense" Class="mt-0" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Index" Title="@L["Index"]" Editable="false" />
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                <PropertyColumn Property="x => x.Level" Title="@L["Level"]" />
                <PropertyColumn Property="x => x.MaxLife" Title="@L["Life"]" />
                <PropertyColumn Property="x => x.MaxMana" Title="@L["Mana"]" />
                <PropertyColumn Property="x => x.DamageMin" Title="@L["Min. damage"]" />
                <PropertyColumn Property="x => x.DamageMax" Title="@L["Max. damage"]" />
                <PropertyColumn Property="x => x.Defense" Title="@L["Defense"]" />
                <PropertyColumn Property="x => x.MagicDefense" Title="@L["Magic def."]" />
                <PropertyColumn Property="x => x.AttackRate" Title="@L["Hit rate"]" />
                <PropertyColumn Property="x => x.DefenseRate" Title="@L["Dodge"]" />
                <PropertyColumn Property="x => x.MoveRange" Title="@L["Move range"]" />
                <PropertyColumn Property="x => x.AttackRange" Title="@L["Attack range"]" />
                <PropertyColumn Property="x => x.ViewRange" Title="@L["View"]" />
                <PropertyColumn Property="x => x.MoveSpeed" Title="@L["Move speed"]" />
                <PropertyColumn Property="x => x.AttackSpeed" Title="@L["Attack speed"]" />
                <PropertyColumn Property="x => x.RegenTime" Title="@L["Respawn"]" />
                <PropertyColumn Property="x => x.ItemRate" Title="@L["% item"]" />
                <PropertyColumn Property="x => x.MoneyRate" Title="@L["% zen"]" />
                <PropertyColumn Property="x => x.MaxItemLevel" Title="@L["Max. item level"]" />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save" Disabled="@_saving">
            @L["Save to MonsterList.txt"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        @L.F("A backup ({0}) is saved the first time you save in this session.", "MonsterList.txt.bak")
    </MudText>
}

@code {
    private string? _header;
    private List<MonsterRow>? _rows;
    private string? _search;
    private bool _saving;
    private bool _backedUp;

    private string Path => DataPaths.Combine("Monster", "MonsterList.txt");

    private Func<MonsterRow, bool> QuickFilter => row =>
        string.IsNullOrWhiteSpace(_search)
        || row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || row.Index.ToString().Contains(_search);

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync()
    {
        var (header, rows) = MonsterFileRepository.Load(Path);
        _header = header;
        _rows = rows;
        return Task.CompletedTask;
    }

    private void Save()
    {
        if (_rows is null || _header is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (!_backedUp)
            {
                var backupPath = Path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(Path, backupPath);
                }
                _backedUp = true;
            }

            MonsterFileRepository.Save(Path, _header, _rows);
            Snackbar.Add(L.F("Saved: {0} monsters.", _rows.Count), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
