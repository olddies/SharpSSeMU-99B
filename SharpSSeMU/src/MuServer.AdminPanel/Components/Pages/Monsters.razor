@page "/monsters"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>Monstruos</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Monstruos</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Data/Monster/MonsterList.txt -- las estadísticas de cada tipo de monstruo. Esto define <b>qué es</b>
    cada monstruo, no dónde aparece: los spawns viven en Data/Monster/Spawn/*.txt y no se editan acá.
</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    Los valores de vida/defensa/daño que ves acá son los del archivo; el GameServer les aplica encima
    los multiplicadores globales de <b>Configuración → Monster Settings</b> (MonsterMaxLifeRate,
    MonsterPhysiDamageRate, etc.) al instanciar cada monstruo.
</MudAlert>

@if (_rows is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-2" Elevation="0">
        <MudDataGrid Items="@_rows" T="MonsterRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     Bordered="false" Dense="true" FixedHeader="true" Height="65vh"
                     Filterable="true" SortMode="SortMode.Multiple" QuickFilter="@QuickFilter">
            <ToolBarContent>
                <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar por nombre o índice"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Clearable="true" Margin="Margin.Dense" Class="mt-0" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Index" Title="Índice" Editable="false" />
                <PropertyColumn Property="x => x.Name" Title="Nombre" />
                <PropertyColumn Property="x => x.Level" Title="Nivel" />
                <PropertyColumn Property="x => x.MaxLife" Title="Vida" />
                <PropertyColumn Property="x => x.MaxMana" Title="Maná" />
                <PropertyColumn Property="x => x.DamageMin" Title="Daño mín." />
                <PropertyColumn Property="x => x.DamageMax" Title="Daño máx." />
                <PropertyColumn Property="x => x.Defense" Title="Defensa" />
                <PropertyColumn Property="x => x.MagicDefense" Title="Def. mágica" />
                <PropertyColumn Property="x => x.AttackRate" Title="Acierto" />
                <PropertyColumn Property="x => x.DefenseRate" Title="Evasión" />
                <PropertyColumn Property="x => x.MoveRange" Title="Rango mov." />
                <PropertyColumn Property="x => x.AttackRange" Title="Rango atq." />
                <PropertyColumn Property="x => x.ViewRange" Title="Visión" />
                <PropertyColumn Property="x => x.MoveSpeed" Title="Vel. mov." />
                <PropertyColumn Property="x => x.AttackSpeed" Title="Vel. atq." />
                <PropertyColumn Property="x => x.RegenTime" Title="Respawn" />
                <PropertyColumn Property="x => x.ItemRate" Title="% item" />
                <PropertyColumn Property="x => x.MoneyRate" Title="% zen" />
                <PropertyColumn Property="x => x.MaxItemLevel" Title="Nivel máx. item" />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save" Disabled="@_saving">
            Guardar en MonsterList.txt
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@_saving">
            Descartar cambios
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        Se guarda un respaldo (MonsterList.txt.bak) la primera vez que grabás en esta sesión.
    </MudText>
}

@code {
    private string? _header;
    private List<MonsterRow>? _rows;
    private string? _search;
    private bool _saving;
    private bool _backedUp;

    private string Path => DataPaths.Combine("Monster", "MonsterList.txt");

    private Func<MonsterRow, bool> QuickFilter => row =>
        string.IsNullOrWhiteSpace(_search)
        || row.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || row.Index.ToString().Contains(_search);

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync()
    {
        var (header, rows) = MonsterFileRepository.Load(Path);
        _header = header;
        _rows = rows;
        return Task.CompletedTask;
    }

    private void Save()
    {
        if (_rows is null || _header is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (!_backedUp)
            {
                var backupPath = Path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(Path, backupPath);
                }
                _backedUp = true;
            }

            MonsterFileRepository.Save(Path, _header, _rows);
            Snackbar.Add($"Guardado: {_rows.Count} monstruos.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
