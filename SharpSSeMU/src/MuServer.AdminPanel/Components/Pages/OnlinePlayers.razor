@page "/online-players"
@using MuServer.AdminPanel.Repositories
@inject ServerStatusRepository StatusRepository
@implements IDisposable

<PageTitle>@L["Connected accounts"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Connected accounts"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Live reading of Data/status.json (the GameServer rewrites it every 3s) -- read-only, nothing about the character can be edited here."]
</MudText>

@if (_status is null)
{
    <MudAlert Severity="Severity.Warning">
        @L["Data/status.json not found -- is the GameServer running?"]
    </MudAlert>
}
else if (_status.IsStale)
{
    <MudAlert Severity="Severity.Warning">
        @L.F("The GameServer has not updated its status for {0}s -- the list below may be out of date.", (int)(DateTime.UtcNow - _status.UpdatedAtUtc).TotalSeconds)
    </MudAlert>
}
else if (_status.Players.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["Nobody is connected right now."]</MudAlert>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true">
        <thead>
            <tr>
                <th>@L["Account"]</th>
                <th>@L["Character"]</th>
                <th>@L["Class"]</th>
                <th>@L["Level"]</th>
                <th>@L["Reset"]</th>
                <th>@L["Map (code)"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _status.Players.OrderBy(p => p.Name))
            {
                <tr>
                    <td>@p.Account</td>
                    <td>@p.Name</td>
                    <td>@p.ClassName</td>
                    <td>@p.Level</td>
                    <td>@p.Reset</td>
                    <td>@p.Map</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private ServerStatusInfo? _status;
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _status = StatusRepository.Read();
        _timer = new Timer(_ => InvokeAsync(Refresh), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void Refresh()
    {
        _status = StatusRepository.Read();
        StateHasChanged();
    }

    public void Dispose() => _timer?.Dispose();
}
