@page "/rates"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Rates"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Server rates"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["What is touched most when configuring a server -- experience, drops, zen, jewels -- picked by hand from Data/GameServerInfo - Common.dat and named after what each thing does. It is a shortcut: all ~845 raw fields are still available in"] <b>@L["Configuration"]</b>.
</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
    @L["The GameServer reads this file"] <b>@L["at start-up"]</b>@L[": changes only apply when you restart it. Fields marked with"] <MudChip T="string" Size="Size.Small" Class="ma-0">@L["4 account levels"]</MudChip> @L["are written to all four (AL0-AL3) at once; use the Configuration page to give different values per account level."]
</MudAlert>

@if (_doc is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTextField T="string" @bind-Value="_filter" Label="@L["Search setting"]" Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Clearable="true" Margin="Margin.Dense" Class="mb-4" Style="max-width: 420px;" />

    @foreach (var group in VisibleGroups)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="mb-3">@L[group.Title]</MudText>
            <MudGrid Spacing="3">
                @foreach (var setting in VisibleSettings(group))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="int" Value="@GetValue(setting)"
                                         ValueChanged="@(v => SetValue(setting, v))"
                                         Label="@L[setting.Label]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @L[setting.Help]
                            <span class="rate-key">@setting.Key@(setting.PerAccountLevel ? "_AL0-3" : "")</span>
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    @if (!VisibleGroups.Any())
    {
        <MudAlert Severity="Severity.Info">@L.F("No setting matches \"{0}\".", _filter)</MudAlert>
    }

    <div class="d-flex gap-2 mt-2 mb-8">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save" Disabled="@_saving">
            @L.F("Save ({0} change(s))", _pending.Count)
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Reload" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
    </div>
}

<style>
    .rate-key {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        opacity: 0.5;
        margin-top: 2px;
    }
</style>

@code {
    private IniDocument? _doc;
    private readonly Dictionary<string, int> _pending = new();
    private string? _filter;
    private bool _saving;
    private bool _backedUp;

    private string Path => DataPaths.Combine(RateSettings.FileName);

    private IEnumerable<RateGroup> VisibleGroups => RateSettings.Groups.Where(g => VisibleSettings(g).Any());

    private IEnumerable<RateSetting> VisibleSettings(RateGroup group) =>
        string.IsNullOrWhiteSpace(_filter)
            ? group.Settings
            : group.Settings.Where(s =>
                s.Label.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || s.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _doc = IniDocument.Load(Path);
        _pending.Clear();
    }

    /// <summary>Per-account-level keys live as <c>Key_AL0</c>; AL0 is read as the representative of the
    /// four.</summary>
    private static string ReadKey(RateSetting setting) => setting.PerAccountLevel ? setting.Key + "_AL0" : setting.Key;

    private int GetValue(RateSetting setting) =>
        _pending.TryGetValue(setting.Key, out var pending)
            ? pending
            : _doc!.GetInt(RateSettings.Section, ReadKey(setting));

    private void SetValue(RateSetting setting, int value) => _pending[setting.Key] = value;

    private void Save()
    {
        if (_doc is null || _pending.Count == 0)
        {
            Snackbar.Add(L["There are no changes to save."], Severity.Info);
            return;
        }

        _saving = true;
        try
        {
            if (!_backedUp)
            {
                var backupPath = Path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(Path, backupPath);
                }
                _backedUp = true;
            }

            int changed = _pending.Count;

            foreach (var (key, value) in _pending)
            {
                var setting = RateSettings.Groups.SelectMany(g => g.Settings).First(s => s.Key == key);

                if (setting.PerAccountLevel)
                {
                    for (int al = 0; al < 4; al++)
                    {
                        _doc.SetInt(RateSettings.Section, $"{key}_AL{al}", value);
                    }
                }
                else
                {
                    _doc.SetInt(RateSettings.Section, key, value);
                }
            }

            _doc.Save(Path);
            Snackbar.Add(L.F("Saved: {0} setting(s). Restart the GameServer for them to apply.", changed), Severity.Success);
            Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
