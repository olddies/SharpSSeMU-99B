@page "/config"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Configuration"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Configuration"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["The complete Data/GameServerInfo - *.dat files, exactly as the GameServer reads them at start-up. The groups and their order come from the file's own comments, so what you see here is exactly what is inside -- nothing is filtered or renamed."]
</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
    @L["The GameServer reads these files"] <b>@L["only once, at start-up"]</b>@L[": any change only applies when you restart it. Note also that many fields belong to systems that are not ported yet (PK, trade, guild, resets...): they save fine, but will do nothing until that system exists."]
</MudAlert>

<MudSelect T="string" Value="_selectedFile" ValueChanged="OnFileChangedAsync" Label="@L["File"]"
           Variant="Variant.Outlined" Dense="true" Class="mb-4" Style="max-width: 420px;">
    @foreach (var file in ConfigFiles)
    {
        <MudSelectItem Value="file">@file</MudSelectItem>
    }
</MudSelect>

@if (_doc is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_doc.Groups.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["This file has no keys to edit."]</MudAlert>
}
else
{
    <MudTextField T="string" @bind-Value="_filter" Label="@L["Search key"]" Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Clearable="true" Margin="Margin.Dense" Class="mb-4" Style="max-width: 420px;" />

    @if (!VisibleGroups.Any())
    {
        <MudAlert Severity="Severity.Info">
            @L.F("No key in this file matches \"{0}\".", _filter)
        </MudAlert>
    }

    @foreach (var group in VisibleGroups)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="mb-3">@group.Title</MudText>
            <MudGrid Spacing="2">
                @foreach (var entry in VisibleEntries(group))
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        @if (entry.IsNumeric)
                        {
                            <MudNumericField T="int" Value="@ToInt(entry.Value)"
                                             ValueChanged="@(v => entry.Value = v.ToString())"
                                             Label="@entry.Key" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else
                        {
                            <MudTextField T="string" @bind-Value="entry.Value" Label="@entry.Key"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    <div class="d-flex gap-2 mt-2 mb-8">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@_saving">
            @L.F("Save ({0} change(s))", DirtyCount)
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
    </div>
}

@code {
    private static readonly string[] ConfigFiles =
    [
        "GameServerInfo - Common.dat",
        "GameServerInfo - Character.dat",
        "GameServerInfo - ChaosMix.dat",
        "GameServerInfo - Command.dat",
        "GameServerInfo - Custom.dat",
        "GameServerInfo - Event.dat",
        "GameServerInfo - Item.dat",
        "GameServerInfo - Skill.dat",
    ];

    private string _selectedFile = ConfigFiles[0];
    private IniDocument? _doc;
    private string? _filter;
    private bool _saving;
    private bool _backedUp;

    private string Path => DataPaths.Combine(_selectedFile);

    private int DirtyCount => _doc?.Groups.SelectMany(g => g.Entries).Count(e => e.IsDirty) ?? 0;

    private IEnumerable<IniGroup> VisibleGroups =>
        _doc!.Groups.Where(g => VisibleEntries(g).Any());

    private IEnumerable<IniEntry> VisibleEntries(IniGroup group) =>
        string.IsNullOrWhiteSpace(_filter)
            ? group.Entries
            : group.Entries.Where(e => e.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private static int ToInt(string value) => int.TryParse(value.Trim(), out var n) ? n : 0;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task OnFileChangedAsync(string file)
    {
        _selectedFile = file;
        _backedUp = false;
        // The filter belongs to the previous search: leaving it set when switching files gives an empty
        // page with no explanation (a file's keys rarely exist in the other).
        _filter = null;
        return ReloadAsync();
    }

    private Task ReloadAsync()
    {
        _doc = IniDocument.Load(Path);
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_doc is null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (!_backedUp)
            {
                var backupPath = Path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(Path, backupPath);
                }
                _backedUp = true;
            }

            var changed = DirtyCount;
            _doc.ApplyGroupEdits();
            _doc.Save(Path);
            Snackbar.Add(L.F("Saved: {0} value(s) in {1}.", changed, _selectedFile), Severity.Success);

            // Reload so that OriginalValue is again what is on disk (otherwise what was just saved
            // would keep counting as a "pending change").
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
