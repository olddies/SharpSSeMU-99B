@page "/shops"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Shops"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Shops"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Data/ShopManager.txt (where each NPC stands) and Data/Shop/*.txt (what each one sells). Each item's name comes from Item.txt, so if none shows up it is because that index does not exist in the items file."]
</MudText>

@if (_npcs is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pt-2">
        <MudTabPanel Text="@L["Items per shop"]" Icon="@Icons.Material.Filled.Storefront">
            <MudSelect T="ShopNpcRow" Value="_selectedNpc" ValueChanged="OnNpcChanged" Label="@L["Shop"]"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Style="max-width: 460px;"
                       ToStringFunc="@(n => n is null ? "" : $"{n.NpcIndex} -- {n.ShopPath}")">
                @foreach (var npc in _npcs)
                {
                    <MudSelectItem Value="npc">@($"{npc.NpcIndex} -- {npc.ShopPath}")</MudSelectItem>
                }
            </MudSelect>

            @if (_shopLoadError is not null)
            {
                <MudAlert Severity="Severity.Warning">@_shopLoadError</MudAlert>
            }
            else if (_shopItems is not null)
            {
                <MudPaper Class="pa-2" Elevation="0">
                    <MudDataGrid Items="@_shopItems" T="ShopItemRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                                 Bordered="false" Dense="true" FixedHeader="true" Height="55vh" SortMode="SortMode.Multiple">
                        <Columns>
                            <PropertyColumn Property="x => x.Section" Title="@L["Section"]" />
                            <PropertyColumn Property="x => x.Sub" Title="@L["Index"]" />
                            <TemplateColumn Title="Item" Editable="false" Sortable="false">
                                <CellTemplate>
                                    @ItemName(context.Item)
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Level" Title="@L["Level"]" />
                            <PropertyColumn Property="x => x.Durability" Title="@L["Durability"]" />
                            <PropertyColumn Property="x => x.Skill" Title="Skill" />
                            <PropertyColumn Property="x => x.Luck" Title="@L["Luck"]" />
                            <PropertyColumn Property="x => x.Additional" Title="@L["Additional"]" />
                            <PropertyColumn Property="x => x.Excellent" Title="@L["Excellent"]" />
                            <PropertyColumn Property="x => x.SetOption" Title="Set" />
                            <TemplateColumn Title="" Editable="false" Sortable="false">
                                <CellTemplate>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   OnClick="@(() => RemoveItem(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudPaper>

                <div class="d-flex gap-2 mt-4 align-center flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveShop" Disabled="@_saving">
                        @L["Save shop items"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem">
                        @L["Add item"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadShopItems(_selectedNpc))" Disabled="@_saving">
                        @L["Discard changes"]
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @L.F("{0} item(s) for sale", _shopItems.Count)
                    </MudText>
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="@L["NPC locations"]" Icon="@Icons.Material.Filled.PinDrop">
            <MudPaper Class="pa-2" Elevation="0">
                <MudDataGrid Items="@_npcs" T="ShopNpcRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                             Bordered="false" Dense="true" FixedHeader="true" Height="55vh" SortMode="SortMode.Multiple">
                    <Columns>
                        <PropertyColumn Property="x => x.NpcIndex" Title="NPC" Editable="false" />
                        <PropertyColumn Property="x => x.ShopPath" Title="@L["Shop file"]" Editable="false" />
                        <PropertyColumn Property="x => x.MapNumber" Title="@L["Map"]" />
                        <PropertyColumn Property="x => x.LocationX" Title="X" />
                        <PropertyColumn Property="x => x.LocationY" Title="Y" />
                        <PropertyColumn Property="x => x.Direction" Title="@L["Direction"]" />
                    </Columns>
                </MudDataGrid>
            </MudPaper>

            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveManager" Disabled="@_saving">
                    @L["Save to ShopManager.txt"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="LoadManager" Disabled="@_saving">
                    @L["Discard changes"]
                </MudButton>
            </div>
        </MudTabPanel>
    </MudTabs>

    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-4 d-block">
        @L["A backup (.bak) of each file is saved the first time you save in this session."]
    </MudText>
}

@code {
    private string? _managerHeader;
    private List<ShopNpcRow>? _npcs;

    private ShopNpcRow? _selectedNpc;
    private string? _shopHeader;
    private List<ShopItemRow>? _shopItems;
    private string? _shopLoadError;

    private Dictionary<int, string> _itemNames = new();
    private readonly HashSet<string> _backedUp = new();
    private bool _saving;

    private string ManagerPath => DataPaths.Combine("ShopManager.txt");

    private string ShopPathFor(ShopNpcRow npc) => DataPaths.Combine("Shop", npc.ShopPath + ".txt");

    protected override void OnInitialized()
    {
        LoadItemNames();
        LoadManager();

        if (_npcs is { Count: > 0 })
        {
            OnNpcChanged(_npcs[0]);
        }
    }

    /// <summary>Combined index (section*512+sub, same as Item.GetItem) -> name, so that
    /// "Jewel of Bless" can be shown instead of "14,013".</summary>
    private void LoadItemNames()
    {
        try
        {
            var (_, rowsBySection) = ItemFileRepository.Load(DataPaths.Combine("Item", "Item.txt"));
            _itemNames = rowsBySection.Values
                .SelectMany(rows => rows)
                .ToDictionary(r => r.Index, r => r.Name);
        }
        catch (Exception)
        {
            // Without Item.txt the page still works, just without item names.
            _itemNames = new Dictionary<int, string>();
        }
    }

    private string ItemName(ShopItemRow row) =>
        _itemNames.TryGetValue(row.Sub + row.Section * 512, out var name) ? name : L["(unknown)"];

    private void LoadManager()
    {
        var (header, rows) = ShopFileRepository.LoadManager(ManagerPath);
        _managerHeader = header;
        _npcs = rows;
    }

    private void OnNpcChanged(ShopNpcRow npc)
    {
        _selectedNpc = npc;
        LoadShopItems(npc);
    }

    private void LoadShopItems(ShopNpcRow? npc)
    {
        _shopLoadError = null;
        _shopItems = null;

        if (npc is null)
        {
            return;
        }

        var path = ShopPathFor(npc);

        if (!File.Exists(path))
        {
            _shopLoadError = L.F("Data/Shop/{0}.txt was not found -- this NPC points to a file that does not exist.", npc.ShopPath);
            return;
        }

        var (header, rows) = ShopFileRepository.LoadShop(path);
        _shopHeader = header;
        _shopItems = rows;
    }

    private void AddItem()
    {
        _shopItems?.Add(new ShopItemRow { Section = 14, Sub = 0, Durability = 1 });
    }

    private void RemoveItem(ShopItemRow row)
    {
        _shopItems?.Remove(row);
    }

    private void Backup(string path)
    {
        if (_backedUp.Contains(path))
        {
            return;
        }

        var backupPath = path + ".bak";
        if (!File.Exists(backupPath))
        {
            File.Copy(path, backupPath);
        }
        _backedUp.Add(path);
    }

    private void SaveShop()
    {
        if (_shopItems is null || _shopHeader is null || _selectedNpc is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var path = ShopPathFor(_selectedNpc);
            Backup(path);
            ShopFileRepository.SaveShop(path, _shopHeader, _shopItems);
            Snackbar.Add(L.F("Saved: {0} item(s) in {1}.", _shopItems.Count, _selectedNpc.ShopPath), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void SaveManager()
    {
        if (_npcs is null || _managerHeader is null)
        {
            return;
        }

        _saving = true;
        try
        {
            Backup(ManagerPath);
            ShopFileRepository.SaveManager(ManagerPath, _managerHeader, _npcs);
            Snackbar.Add(L.F("Saved: {0} shop NPC(s).", _npcs.Count), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
