@page "/spawns"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>Spawns</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Spawns de monstruos</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Data/Monster/Spawn/*.txt -- dónde aparece cada monstruo, un archivo por mapa. Las estadísticas de
    cada monstruo (vida, daño) se editan en <b>Monstruos</b>; acá sólo se define dónde y cuántos.
</MudText>

@if (_files.Count == 0)
{
    <MudAlert Severity="Severity.Warning">No se encontró la carpeta Data/Monster/Spawn.</MudAlert>
}
else
{
    <MudSelect T="string" Value="_selectedFile" ValueChanged="OnFileChanged" Label="Mapa"
               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Style="max-width: 420px;">
        @foreach (var file in _files)
        {
            <MudSelectItem Value="file">@file.Replace(".txt", "")</MudSelectItem>
        }
    </MudSelect>

    @if (_blocks is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        @foreach (var block in _blocks)
        {
            <MudPaper Class="pa-3 mb-4" Elevation="0">
                <div class="d-flex align-center gap-2 mb-2">
                    <MudText Typo="Typo.subtitle1">@BlockTitle(block.SpawnType)</MudText>
                    <MudChip T="string" Size="Size.Small" Class="ma-0">@block.Rows.Count fila(s)</MudChip>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">@BlockHelp(block.SpawnType)</MudText>

                <MudDataGrid Items="@block.Rows" T="SpawnRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                             Bordered="false" Dense="true" FixedHeader="true" Height="@GridHeight(block)"
                             SortMode="SortMode.Multiple">
                    <Columns>
                        <PropertyColumn Property="x => x.MonsterClass" Title="Monstruo" />
                        <TemplateColumn Title="Nombre" Editable="false" Sortable="false">
                            <CellTemplate>@MonsterName(context.Item.MonsterClass)</CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Distance" Title="Radio" />
                        <PropertyColumn Property="x => x.X" Title="X" />
                        <PropertyColumn Property="x => x.Y" Title="Y" />
                        <PropertyColumn Property="x => x.X2" Title="X2" Hidden="@(!block.IsArea)" />
                        <PropertyColumn Property="x => x.Y2" Title="Y2" Hidden="@(!block.IsArea)" />
                        <PropertyColumn Property="x => x.Count" Title="Cantidad" Hidden="@(!block.IsArea)" />
                        <PropertyColumn Property="x => x.Direction" Title="Dirección" />
                        <TemplateColumn Title="" Editable="false" Sortable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               OnClick="@(() => block.Rows.Remove(context.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>

                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                           Class="mt-2" OnClick="@(() => AddRow(block))">
                    Agregar spawn
                </MudButton>
            </MudPaper>
        }

        <div class="d-flex gap-2 mt-2 mb-8">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Save" Disabled="@_saving">
                Guardar @_selectedFile
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadFile(_selectedFile))" Disabled="@_saving">
                Descartar cambios
            </MudButton>
        </div>
    }
}

@code {
    private List<string> _files = [];
    private string _selectedFile = string.Empty;
    private string? _header;
    private List<SpawnBlock>? _blocks;
    private Dictionary<int, string> _monsterNames = new();
    private readonly HashSet<string> _backedUp = new();
    private bool _saving;

    private string SpawnDirectory => DataPaths.Combine("Monster", "Spawn");

    private string PathFor(string file) => System.IO.Path.Combine(SpawnDirectory, file);

    protected override void OnInitialized()
    {
        LoadMonsterNames();
        _files = SpawnFileRepository.ListFiles(SpawnDirectory).ToList();

        if (_files.Count > 0)
        {
            OnFileChanged(_files[0]);
        }
    }

    private void LoadMonsterNames()
    {
        try
        {
            var (_, rows) = MonsterFileRepository.Load(DataPaths.Combine("Monster", "MonsterList.txt"));
            _monsterNames = rows.ToDictionary(r => r.Index, r => r.Name);
        }
        catch (Exception)
        {
            _monsterNames = new Dictionary<int, string>();
        }
    }

    private string MonsterName(int monsterClass) =>
        _monsterNames.TryGetValue(monsterClass, out var name) ? name : "(desconocido)";

    private static string BlockTitle(int type) => type switch
    {
        0 => "Posición fija",
        1 => "Área (con cantidad)",
        2 => "Posición fija con desvío aleatorio",
        4 => "Posiciones de evento",
        _ => $"Tipo {type}",
    };

    private static string BlockHelp(int type) => type switch
    {
        0 => "Un monstruo por fila, en la coordenada exacta.",
        1 => "Reparte la cantidad indicada de monstruos dentro del rectángulo X,Y - X2,Y2.",
        2 => "Como la posición fija, pero el servidor le suma un desvío al azar de ±3 al cargar.",
        4 => "No aparecen al arrancar: son las posiciones candidatas que usan los eventos (Devil Square, Blood Castle) para poner sus monstruos.",
        _ => "Tipo de bloque no reconocido por el servidor -- se conserva tal cual.",
    };

    private static string GridHeight(SpawnBlock block) => block.Rows.Count > 12 ? "45vh" : "";

    private void OnFileChanged(string file)
    {
        _selectedFile = file;
        LoadFile(file);
    }

    private void LoadFile(string file)
    {
        var (header, blocks) = SpawnFileRepository.Load(PathFor(file));
        _header = header;
        _blocks = blocks;
    }

    private static void AddRow(SpawnBlock block)
    {
        block.Rows.Add(new SpawnRow { SpawnType = block.SpawnType, MonsterClass = 0, Direction = -1 });
    }

    private void Save()
    {
        if (_blocks is null || _header is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var path = PathFor(_selectedFile);

            if (_backedUp.Add(path))
            {
                var backupPath = path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(path, backupPath);
                }
            }

            SpawnFileRepository.Save(path, _header, _blocks);
            Snackbar.Add($"Guardado: {_blocks.Sum(b => b.Rows.Count)} spawn(s) en {_selectedFile}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
