@page "/warps"
@using MuServer.AdminPanel.Config
@using MuServer.AdminPanel.Repositories
@inject GameDataPaths DataPaths
@inject ISnackbar Snackbar

<PageTitle>@L["Warps"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">@L["Warps"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @L["Data/Move/Move.txt -- what the client shows in the move window and what the server really accepts are the same file, so a change here applies to both sides without desynchronising them."]
</MudText>

@if (_rows is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-2" Elevation="0">
        <MudDataGrid Items="@_rows" T="MoveRow" EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     Bordered="false" Dense="true" FixedHeader="true" Height="70vh"
                     Filterable="true" SortMode="SortMode.Multiple">
            <Columns>
                <PropertyColumn Property="x => x.Index" Title="@L["Index"]" Editable="false" />
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                <PropertyColumn Property="x => x.RequireMoney" Title="Zen" Format="N0" />
                <PropertyColumn Property="x => x.MinLevel" Title="@L["Min. level"]" />
                <PropertyColumn Property="x => x.MaxLevel" Title="@L["Max. level"]" />
                <PropertyColumn Property="x => x.GateNumber" Title="@L["Gate"]" />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@_saving">
            @L["Save to Move.txt"]
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@_saving">
            @L["Discard changes"]
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        @L.F("A backup ({0}) is saved the first time you save in this session.", "Move.txt.bak")
    </MudText>
}

@code {
    private string? _header;
    private List<MoveRow>? _rows;
    private bool _saving;
    private bool _backedUp;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadAsync()
    {
        var path = DataPaths.Combine("Move", "Move.txt");
        var (header, rows) = MoveFileRepository.Load(path);
        _header = header;
        _rows = rows;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_rows is null || _header is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var path = DataPaths.Combine("Move", "Move.txt");

            if (!_backedUp)
            {
                var backupPath = path + ".bak";
                if (!File.Exists(backupPath))
                {
                    File.Copy(path, backupPath);
                }
                _backedUp = true;
            }

            MoveFileRepository.Save(path, _header, _rows);
            Snackbar.Add(L.F("Saved: {0} warps.", _rows.Count), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.F("Could not save: {0}", ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
