@using MuServer.AdminPanel.Repositories

@* Native HTML table instead of MudDataGrid on purpose: a character has 108-120 slots, and
   MudDataGrid in cell-edit mode instantiates a whole MudBlazor component (with its own JS
   interop) per editable cell -- for 100+ rows x 8 columns that is several hundred live
   components at once, and in practice it became so heavy that the Blazor Server circuit stopped
   answering the SignalR keepalive and the whole panel hung on "loading" with no visible error
   (the server finished computing everything, but the browser never got to apply the render).
   Native <input>s with @@bind do not have that cost.

   That is also why the "pick item" button is a native <button> that calls OnPickItem (a callback
   supplied by the parent) instead of having its own <MudIconButton>/IDialogService/Catalog
   parameter here: whoever opens the search dialog is Characters.razor (a single MudDialog for both
   grids, mounted once), not this grid -- so no "heavy" component or parameter is multiplied per row. *@
<div class="mb-2">
    <input @bind="_filter" @bind:event="oninput" placeholder="@L["Filter by slot, index or name..."]"
           class="item-slot-filter" />
</div>
<div style="max-height: 50vh; overflow-y: auto;">
    <table class="item-slot-table">
        <thead>
            <tr>
                <th>Slot</th>
                <th>@L["Location"]</th>
                <th>@L["Index"]</th>
                <th>@L["Name"]</th>
                <th>@L["Level (+)"]</th>
                <th>@L["Durab."]</th>
                <th>@L["Luck"]</th>
                <th>@L["Skill"]</th>
                <th>@L["Option"]</th>
                <th>@L["Excel."]</th>
                <th>Set</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in FilteredRows)
            {
                <tr>
                    <td>@row.Slot</td>
                    <td>@row.Label</td>
                    <td>
                        <div class="item-slot-index-cell">
                            <input type="number" @bind="row.Index" class="item-slot-num" />
                            <button type="button" class="item-slot-btn" title="@L["Search item"]"
                                    @onclick="@(() => OnPickItem(row))">🔍</button>
                        </div>
                    </td>
                    <td class="item-slot-name">@ResolveName(row.Index)</td>
                    <td><input type="number" @bind="row.Level" min="0" max="15" class="item-slot-num" /></td>
                    <td><input type="number" @bind="row.Durability" min="0" max="255" class="item-slot-num" /></td>
                    <td><input type="number" @bind="row.Luck" min="0" max="1" class="item-slot-num" /></td>
                    <td><input type="number" @bind="row.Skill" min="0" max="1" class="item-slot-num" /></td>
                    <td><input type="number" @bind="row.OptionLevel" min="0" class="item-slot-num" /></td>
                    <td><input type="number" @bind="row.Excellent" min="0" class="item-slot-num" /></td>
                    <td><input type="number" @bind="row.SetItem" min="0" class="item-slot-num" /></td>
                    <td>
                        <button type="button" class="item-slot-btn" title="@L["Clear slot"]" disabled="@(row.Index < 0)"
                                @onclick="@(() => Clear(row))">✕</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .item-slot-filter {
        width: 100%;
        max-width: 400px;
        padding: 6px 10px;
        border-radius: 4px;
        border: 1px solid var(--mud-palette-lines-inputs, #999);
        background: transparent;
        color: inherit;
    }

    .item-slot-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
    }

    .item-slot-table th {
        text-align: left;
        padding: 4px 8px;
        position: sticky;
        top: 0;
        background: var(--mud-palette-background, #1e1e2d);
        z-index: 1;
    }

    .item-slot-table td {
        padding: 2px 8px;
        border-top: 1px solid var(--mud-palette-lines-default, #333);
    }

    .item-slot-name {
        white-space: nowrap;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .item-slot-num {
        width: 64px;
        background: transparent;
        color: inherit;
        border: 1px solid var(--mud-palette-lines-inputs, #666);
        border-radius: 4px;
        padding: 2px 4px;
    }

    .item-slot-index-cell {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .item-slot-btn {
        background: transparent;
        color: inherit;
        border: 1px solid var(--mud-palette-lines-inputs, #666);
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.75rem;
        line-height: 1;
        padding: 3px 6px;
    }

    .item-slot-btn:hover {
        background: var(--mud-palette-action-default-hover, rgba(255, 255, 255, 0.1));
    }

    .item-slot-btn:disabled {
        opacity: 0.4;
        cursor: default;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public required List<ItemSlotRow> Rows { get; set; }

    [Parameter, EditorRequired]
    public required Func<int, string> ResolveName { get; set; }

    [Parameter, EditorRequired]
    public required Func<ItemSlotRow, Task> OnPickItem { get; set; }

    private string _filter = string.Empty;

    private IEnumerable<ItemSlotRow> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter))
            {
                return Rows;
            }

            return Rows.Where(r =>
                r.Slot.ToString().Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                r.Label.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                r.Index.ToString().Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                ResolveName(r.Index).Contains(_filter, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void Clear(ItemSlotRow row)
    {
        row.Index = -1;
        row.Level = 0;
        row.Durability = 0;
        row.Luck = 0;
        row.Skill = 0;
        row.OptionLevel = 0;
        row.Excellent = 0;
        row.SetItem = 0;
    }
}
